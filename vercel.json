{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/generate-questions",
      "destination": "/api/generate-questions"
    },
    {
      "source": "/api/evaluate-answer",
      "destination": "/api/evaluate-answer"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
